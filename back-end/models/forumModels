const pool = require("../config/db"); // Import PostgreSQL connection

const Forum = {
    // Get all forum posts
    getAllPosts: async () => {
        const result = await pool.query("SELECT * FROM forums ORDER BY created_at DESC");
        return result.rows;
    },

    // Get a single post by ID
    getPostById: async (id) => {
        const result = await pool.query("SELECT * FROM forums WHERE id = $1", [id]);
        return result.rows[0]; // Return single object
    },

    // Create a new forum post
    createPost: async (title, content, author) => {
        const result = await pool.query(
            "INSERT INTO forums (title, content, author) VALUES ($1, $2, $3) RETURNING *",
            [title, content, author]
        );
        return result.rows[0];
    }
};

module.exports = Forum;